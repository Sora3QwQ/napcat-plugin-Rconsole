{
  "name": "napcat-plugin-rconsole",
  "version": "1.0.0",
  "description": "NapCat multi-platform content parser plugin (bilibili, douyin, weibo, xhs, etc.)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:webui": "vite --config src/webui/vite.config.ts"
  },
  "napcat": {
    "tags": [
      "tool",
      "parser",
      "video",
      "music"
    ],
    "minVersion": "4.14.0"
  },
  "keywords": [
    "napcat",
    "plugin",
    "bilibili",
    "douyin",
    "weibo",
    "xiaohongshu",
    "parser"
  ],
  "author": "rconsole-plus",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "@types/node": "^22.0.0",
    "napcat-types": "latest"
  }
}